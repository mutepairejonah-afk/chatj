# ─────────────────────────────────────────────────────────────────────────────
# ChatApp — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────
# ── Clerk Auth ────────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard → Project Settings → API
# SUPABASE_URL / VITE_SUPABASE_URL  — both point at the same project URL.
# The frontend reads VITE_SUPABASE_URL; the backend (SSR + Express) reads SUPABASE_URL.
SUPABASE_URL=https://REPLACE_ME.supabase.co
VITE_SUPABASE_URL=https://REPLACE_ME.supabase.co
# The browser-safe "publishable" key (anon/public).
# Frontend reads VITE_SUPABASE_PUBLISHABLE_KEY; SSR middleware reads SUPABASE_PUBLISHABLE_KEY.
SUPABASE_PUBLISHABLE_KEY=eyJREPLACE_ME
VITE_SUPABASE_PUBLISHABLE_KEY=eyJREPLACE_ME
# Service-role key — server-side only (backend + SSR). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJREPLACE_ME

# ── AI — OpenRouter ───────────────────────────────────────────────────────────
# Get from https://openrouter.ai/keys
# Free tier model needs no credits: mistralai/mistral-7b-instruct:free
# Premium/Pro tiers use better models — override with OPENROUTER_MODEL_PREMIUM /
# OPENROUTER_MODEL_PRO if you want different ones; they auto-fall back to the
# free model if your account doesn't have access/credits for them.
OPENROUTER_API_KEY=REPLACE_ME

# ── Calls — TURN server (optional but strongly recommended) ──────────────────
# Audio/video calls need a TURN relay for users behind symmetric NAT (common
# on mobile/cellular networks). Without TURN, STUN-only is used as a fallback
# which works for most home/office networks but not all.
#
# This app uses HMAC-SHA1 short-lived credentials (RFC 5766 / coturn
# use-auth-secret mode) — no third-party dependency required.
#
# TURN_SECRET  — shared secret; set the same value in coturn via:
#                  --use-auth-secret --static-auth-secret=<value>
# TURN_URLS    — comma-separated TURN URL(s) pointing at your coturn server:
#                  "turn:turn.example.com:3478,turns:turn.example.com:5349"
# TURN_TTL_SECONDS — credential lifetime (default: 3600 = 1 hour)
#
# Minimal coturn docker-compose:
#   coturn:
#     image: coturn/coturn:latest
#     network_mode: host
#     command: >
#       -n --log-file=stdout
#       --use-auth-secret
#       --static-auth-secret=${TURN_SECRET}
#       --realm=yourdomain.com
#       --no-multicast-peers --no-cli
TURN_SECRET=
TURN_URLS=
TURN_TTL_SECONDS=3600
# Alternative to TURN_URLS: set these and the TURN URL is built automatically
# as turn:<TURN_PUBLIC_HOST>:<TURN_PORT>. Use your server's real public IP or
# LAN IP here, NOT 127.0.0.1, or devices other than this machine can't reach it.
TURN_PUBLIC_HOST=
TURN_PORT=3478

# ── App Config ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Dedicated Socket.io signaling port for calls (native app + web share this).
# Must match EXPO_PUBLIC_API_URL in native/.env.
SIGNALING_PORT=5001
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
SESSION_SECRET=REPLACE_ME
